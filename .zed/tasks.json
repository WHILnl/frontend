[
  {
    "label": "Qt: Configure",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all"
  },
  {
    "label": "Qt: Build",
    "command": "cmake --build build --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "hide": "on_success",
    "save": "all",
    "tags": ["build"]
  },
  {
    "label": "Qt: Preview",
    "command": "cmake --build build --target appfrontend_qmlpreview",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  },
  {
    "label": "Qt: Preview6",
    "command": "cmake --build build --parallel && qmlpreview6 --interactive ./build/appfrontend",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  }
]
